{
  "name": "interaccounts",
  "version": "0.0.1",
  "private": true,
  "useWorkspaces": true,
  "workspaces": [
    "api",
    "contract",
    "_agstate/agoric-servers",
    "ui"
  ],
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@endo/eslint-plugin": "^0.3.24",
    "@endo/ses-ava": "^1.2.2",
    "@jessie.js/eslint-plugin": "^0.1.3",
    "ava": "^6.1.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-jessie": "^0.0.6",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-github": "^4.9.2",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsdoc": "^48.2.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.7.1",
    "@agoric/solo": "agoric-upgrade-16",
    "@agoric/cosmic-swingset": "agoric-upgrade-16",
    "@agoric/eslint-config": "agoric-upgrade-16",
    "patch-package": "latest",
    "postinstall-postinstall": "latest"
  },
  "resolutions": {
    "@babel/code-frame": "7.18.6",
    "**/@endo/base64": "1.0.5",
    "**/@endo/cjs-module-analyzer": "1.0.5",
    "**/@endo/env-options": "1.1.4",
    "**/@endo/eslint-plugin": "2.1.3",
    "**/@endo/where": "1.0.5",
    "**/@endo/zip": "1.0.5",
    "**/@endo/static-module-record": "1.1.2",
    "**/@endo/compartment-mapper": "1.1.5",
    "**/ses": "1.5.0",
    "**/@endo/lockdown": "1.0.7",
    "**/@endo/nat": "5.0.7",
    "**/@endo/promise-kit": "1.1.2",
    "**/@endo/eventual-send": "1.2.2",
    "**/@endo/init": "1.1.2",
    "**/@endo/ses-ava": "1.2.2",
    "**/@endo/errors": "1.2.2",
    "**/@endo/evasive-transform": "1.1.2",
    "**/@endo/memoize": "1.1.2",
    "**/@endo/stream": "1.2.2",
    "**/@endo/common": "1.2.2",
    "**/@endo/pass-style": "1.4.0",
    "**/@endo/bundle-source": "3.2.3",
    "**/@endo/lp32": "1.1.2",
    "**/@endo/netstring": "1.0.7",
    "**/@endo/stream-node": "1.1.2",
    "**/@endo/far": "1.1.2",
    "**/@endo/marshal": "1.5.0",
    "**/@endo/check-bundle": "1.0.7",
    "**/@endo/import-bundle": "1.1.2",
    "**/@endo/captp": "4.2.0",
    "**/@endo/patterns": "1.4.0",
    "**/@endo/exo": "1.5.0"
  },
  "scripts": {
    "lint": "yarn lint-check",
    "lint-check": "yarn workspaces run lint-check",
    "lint-fix": "yarn workspaces run lint-fix",
    "test": "yarn workspaces run test",
    "integration-test": "yarn ava",
    "build": "yarn workspaces run build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "agoric": "agoric-upgrade-16"
  },
  "ava": {
    "files": [
      "integration-test/**/test-*.mjs"
    ],
    "timeout": "20m"
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          "*.js",
          "*.cjs",
          "*.mjs"
        ]
      }
    ]
  },
  "eslintConfig": {
    "root": true,
    "settings": {
      "jsdoc": {
        "mode": "typescript"
      }
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
